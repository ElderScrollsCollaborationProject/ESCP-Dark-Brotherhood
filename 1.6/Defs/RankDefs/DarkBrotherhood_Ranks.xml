<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ESCP.Ranks.RankTrackDef>
        <defName>ESCP_RankTrack_DarkBrotherhood</defName>
        <label>Dark Brotherhood ranks</label>
        <iconPath>UI/Abilities/BlindingPulse</iconPath>
        <guild>DarkBrotherhood</guild>
        <rootTier>ESCP_Rank_DarkBrotherhood_Murderer</rootTier>
        <owningFaction>ESCP_Faction_DarkBrotherhood</owningFaction>
        <collectiveNoun>the Family</collectiveNoun>
        <drillLabel>Blade Work</drillLabel>
        <drillDesc>Practice with any colonist. Both stop what they are doing and both gain skill XP. Once per day.</drillDesc>
        <studyLabel>Study the Mark</studyLabel>
        <studyDesc>Work through the guild's craft with another member. Both gain skill XP. Once per day.</studyDesc>
        <inspectLabel>Check the Blade</inspectLabel>
        <inspectDesc>Look over a junior member's gear. Good upkeep earns praise and poor upkeep earns a sharp word.</inspectDesc>
        <punishLabel>Assign Penance...</punishLabel>
        <punishDesc>Set a junior member to tedious labor for a failure, souring their mood. Once per day per member.</punishDesc>
        <rallyLabel>Sithis Watches!</rallyLabel>
        <rallyDesc>Call on {0} to fight harder for a short while. Once every few days.</rallyDesc>
        <fallInLabel>Attend Me</fallInLabel>
        <fallInDesc>Order {0} to fall in behind you, up to four deep. They hold formation until released.</fallInDesc>
        <dismissLabel>Return to the Shadows</dismissLabel>
        <dismissDesc>Release {0} from formation so they can return to their duties.</dismissDesc>
    </ESCP.Ranks.RankTrackDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_DarkBrotherhood_Murderer</defName>
        <label>murderer</label>
        <description>Has killed, and has been noticed for it.</description>
        <nextTierOptions>
            <li>ESCP_Rank_DarkBrotherhood_Slayer</li>
        </nextTierOptions>
    </ESCP.Ranks.RankTierDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_DarkBrotherhood_Slayer</defName>
        <label>slayer</label>
        <description>Takes contracts and does not ask who sent them.</description>
        <minDaysInRank>4</minDaysInRank>
        <skillRequirements>
            <Melee>5</Melee>
        </skillRequirements>
        <minMissionsCompleted>1</minMissionsCompleted>
        <minGuildReputation>10</minGuildReputation>
        <trainingXpPerHour>
            <Melee>400</Melee>
            <Shooting>150</Shooting>
        </trainingXpPerHour>
        <expedition>ESCP_Expedition_Guild_Novice</expedition>
        <discipline>Combat</discipline>
        <nextTierOptions>
            <li>ESCP_Rank_DarkBrotherhood_Executioner</li>
        </nextTierOptions>
    </ESCP.Ranks.RankTierDef>

