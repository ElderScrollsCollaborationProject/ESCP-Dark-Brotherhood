<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <PawnKindDef Name="ESCP_DarkBrotherhoodKindBase" Abstract="True">
        <race>Human</race>
        <defaultFactionDef>ESCP_Faction_DarkBrotherhood</defaultFactionDef>
        <useFactionXenotypes>true</useFactionXenotypes>
        <maxGenerationAge>55</maxGenerationAge>
        <minGenerationAge>18</minGenerationAge>
        <chemicalAddictionChance>0.02</chemicalAddictionChance>
        <invNutrition>2.7</invNutrition>
        <invFoodDef>MealSurvivalPack</invFoodDef>
        <disallowedTraits>
            <li>Nudist</li>
        </disallowedTraits>
        <pawnGroupDevelopmentStage>Adult</pawnGroupDevelopmentStage>
    </PawnKindDef>

    <PawnKindDef ParentName="ESCP_DarkBrotherhoodKindBase">
        <defName>ESCP_Pawnkind_DarkBrotherhood_Initiate</defName>
        <label>Brotherhood initiate</label>
        <combatPower>60</combatPower>
        <itemQuality>Normal</itemQuality>
        <gearHealthRange>0.7~1.6</gearHealthRange>
        <weaponMoney>150~400</weaponMoney>
        <weaponTags>
            <li>SomeMelee</li>
            <li>SimpleGun</li>
        </weaponTags>
        <apparelMoney>300~700</apparelMoney>
        <techHediffsChance>0</techHediffsChance>
        <initialWillRange>2~5</initialWillRange>
        <initialResistanceRange>10~18</initialResistanceRange>
        <backstoryFiltersOverride>
            <li>
                <categoriesChildhood>
                    <li>ESCP_Backstory_DarkBrotherhood_Child</li>
                </categoriesChildhood>
                <categoriesAdulthood>
                    <li>ESCP_Backstory_DarkBrotherhood_Assassin</li>
                </categoriesAdulthood>
            </li>
        </backstoryFiltersOverride>
    </PawnKindDef>

    <PawnKindDef ParentName="ESCP_DarkBrotherhoodKindBase">
